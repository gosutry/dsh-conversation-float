{
  "name": "dsh-conversation-float",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "description": "Turns the DSH conversation into a floating window that stays usable over plugin and automation pages: keep it on screen, minimise it to a left-sidebar taskbar row, or dock it into the right sidebar.",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "gosutry",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "conversation",
    "chat",
    "floating-window",
    "docked-window",
    "sidebar",
    "layout",
    "web-ui",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosutry/dsh-conversation-float.git"
  },
  "homepage": "https://github.com/gosutry/dsh-conversation-float#readme",
  "bugs": {
    "url": "https://github.com/gosutry/dsh-conversation-float/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
